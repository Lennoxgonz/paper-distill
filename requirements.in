# CPU wheels for torch. uv.toml sets index-strategy so Community Cloud's uv
# install still takes certifi and the other PyPI pins from PyPI. Without that,
# uv treats this index as the only source for certifi and the deploy fails.
--extra-index-url https://download.pytorch.org/whl/cpu

